# =============================================================================
# QR Reviews — переменные окружения.
# Скопируйте в .env:  cp .env.example .env
# В проде ОБЯЗАТЕЛЬНО замените все значения "change-me-*" (иначе бэкенд не стартует
# при APP_ENV=prod).
# =============================================================================

# --- Общее -------------------------------------------------------------------
# dev | test | prod. В prod включаются строгие проверки конфига.
APP_ENV=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Секреты -----------------------------------------------------------------
# Подпись JWT. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-jwt-secret
# Соль (HMAC-ключ) для хэширования IP и device_id. Смена соли «обнуляет» антифрод-историю.
HASH_SALT=change-me-hash-salt
# Общий секрет между ботом и бэкендом для внутреннего API (/internal/*).
INTERNAL_API_SECRET=change-me-internal-secret

# --- PostgreSQL --------------------------------------------------------------
# Из этих значений docker compose собирает DATABASE_URL для сервисов.
POSTGRES_USER=qr
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=qr_reviews
# Порт Postgres, проброшенный на хост в dev (на случай, если 5432 занят).
POSTGRES_HOST_PORT=5432
# Вне docker compose (CI, локальный запуск uv) задайте DATABASE_URL напрямую:
# DATABASE_URL=postgresql+asyncpg://qr:password@localhost:5432/qr_reviews
# TEST_DATABASE_URL=postgresql+asyncpg://qr:password@localhost:5432/qr_reviews_test

# --- Redis -------------------------------------------------------------------
REDIS_HOST_PORT=6379
# REDIS_URL=redis://localhost:6379/0

# --- URL ---------------------------------------------------------------------
# Базовый адрес, на который ведут QR-коды: {PUBLIC_BASE_URL}/r/{token}
PUBLIC_BASE_URL=http://localhost:8080
# Адрес личного кабинета (используется в ссылках-приглашениях).
DASHBOARD_BASE_URL=http://localhost:8080
# Разрешённые CORS-источники через запятую (нужны, только если кабинет на другом домене).
CORS_ORIGINS=http://localhost:5173

# --- Авторизация -------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Флаг Secure для refresh-cookie. В проде (HTTPS) — true.
COOKIE_SECURE=false
# Домен cookie; пусто — текущий хост.
COOKIE_DOMAIN=
# Срок жизни ссылки-приглашения управляющего, дней.
INVITATION_TTL_DAYS=7

# --- Telegram ----------------------------------------------------------------
# Токен от @BotFather. Пусто — бот не запускается, алерты не отправляются.
TELEGRAM_BOT_TOKEN=
# Username бота без @, для deep link t.me/<username>?start=<code>
TELEGRAM_BOT_USERNAME=
# Срок жизни одноразового кода привязки, минут.
TELEGRAM_LINK_CODE_TTL_MINUTES=15
# Адрес бэкенда для бота (внутри docker-сети).
BACKEND_INTERNAL_URL=http://backend:8000

# --- Компания по умолчанию ---------------------------------------------------
# Часовой пояс новых компаний (используется в статистике по дням/неделям/месяцам).
DEFAULT_TIMEZONE=Europe/Moscow

# --- Антифрод ----------------------------------------------------------------
# Подозрительные отзывы НЕ блокируются, а сохраняются с is_suspicious=true.
# Повтор с одного устройства на одну точку: не больше N отзывов за окно.
AF_DEVICE_MAX_PER_POINT=1
AF_DEVICE_WINDOW_HOURS=24
# IP — слабый сигнал (общий Wi-Fi салона):
#   >= AF_IP_SOFT_THRESHOLD отзывов с IP на точку за окно — флаг ТОЛЬКО вместе
#   с другим признаком (всплеск или похожий текст);
#   >= AF_IP_HARD_THRESHOLD — флаг сам по себе.
AF_IP_SOFT_THRESHOLD=5
AF_IP_HARD_THRESHOLD=20
AF_IP_WINDOW_HOURS=24
# Всплески: больше N отзывов за окно на точку / на сотрудника.
AF_BURST_WINDOW_MINUTES=15
AF_BURST_POINT_MAX=10
AF_BURST_EMPLOYEE_MAX=15
# Похожие тексты (simhash): проверяются только тексты длиной от N символов
# после нормализации; похожими считаются при расстоянии Хэмминга <= N.
AF_SIMHASH_MIN_LENGTH=30
AF_SIMHASH_MAX_DISTANCE=3
# Сколько последних отпечатков текстов компании хранить и сколько дней.
AF_SIMHASH_HISTORY_SIZE=500
AF_SIMHASH_TTL_DAYS=30

# --- Rate limit (по IP, Redis) -----------------------------------------------
# Пороги намеренно щедрые: защищают от перебора и ботов, а не от людей.
RATE_LIMIT_LOGIN_MAX=30
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_PUBLIC_FORM_MAX=60
RATE_LIMIT_PUBLIC_FORM_WINDOW_SECONDS=3600

# --- Прод: HTTPS (docker-compose.prod.yml) -----------------------------------
# Домен сервиса и email для Let's Encrypt.
DOMAIN=reviews.example.com
LETSENCRYPT_EMAIL=admin@example.com
